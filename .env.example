# Copy this file to .env for local development (.env is never committed).
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Neon Postgres connection string. Leave empty locally to use a temporary
# in-memory store. Required on Vercel.
DATABASE_URL=

# Password for the admin page (/admin). Pick something long.
ADMIN_PASSWORD=

# Optional. Signs admin login cookies; defaults to ADMIN_PASSWORD.
SESSION_SECRET=

# Resend API key for sending email (resend.com). Leave empty locally to
# print emails in the terminal instead.
RESEND_API_KEY=

# Who sends and who receives booking emails. The sender's domain must be
# verified in Resend before it can send.
MAIL_FROM=Bonwa Phala Game Lodge <bookings@bonwaphala.africa>
LODGE_EMAIL=bookings@bonwaphala.africa
